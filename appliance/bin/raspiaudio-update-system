#!/usr/bin/env bash
set -euo pipefail

VERSION_FILE="${RASPIAUDIO_VERSION_FILE:-/etc/raspiaudio/version}"
CHANNEL_FILE="${RASPIAUDIO_CHANNEL_FILE:-/etc/raspiaudio/update-channel-url}"
FALLBACK_CHANGELOG="${RASPIAUDIO_CHANGELOG_FILE:-/etc/raspiaudio/changelog.md}"
DEFAULT_CHANNEL_URL="https://raspiaudio.com/camilladsp-box/releases.json"

current_version() {
  if [ -f "$VERSION_FILE" ]; then
    tr -d '\r\n' <"$VERSION_FILE"
  else
    echo "unknown"
  fi
}

channel_url() {
  if [ -n "${RASPIAUDIO_UPDATE_CHANNEL_URL:-}" ]; then
    printf '%s\n' "$RASPIAUDIO_UPDATE_CHANNEL_URL"
    return
  fi
  if [ -f "$CHANNEL_FILE" ]; then
    tr -d '\r\n' <"$CHANNEL_FILE"
    return
  fi
  printf '%s\n' "$DEFAULT_CHANNEL_URL"
}

fetch_and_print_channel() {
  local url="$1"
  python3 - "$url" "$(current_version)" <<'PY'
import json
import sys
import urllib.request

url = sys.argv[1]
current = sys.argv[2]

try:
    with urllib.request.urlopen(url, timeout=10) as response:
        payload = json.loads(response.read().decode("utf-8"))
except Exception as exc:
    sys.exit(1)

product = payload.get("product", "RASPIAUDIO CamillaDSP Box")
latest = payload.get("latest_version", "unknown")
date = payload.get("release_date", "unknown")
page = payload.get("download_page", "")
image = payload.get("image_url", "")
sha = payload.get("sha256_url", "")
imager = payload.get("imager_repository_url", "")
notes = payload.get("changelog", [])

print("Update system")
print(product)
print(f"Current version: {current}")
print(f"Latest version: {latest}")
print(f"Release date: {date}")
print()

if current == latest:
    print("Status: your system is up to date.")
    print()
    print("No action is needed.")
else:
    print("Status: a newer image is available.")
    print()
    print("Next step:")
    if page:
        print(f"Download and flash the latest image from {page}")
    else:
        print("Download and flash the latest image from the RASPIAUDIO support page.")

print()
print("This appliance updates by flashing a new image with Raspberry Pi Imager.")
print()

if page:
    print(f"Page: {page}")
if image:
    print(f"Image: {image}")
if sha:
    print(f"SHA256: {sha}")
if imager:
    print(f"Raspberry Pi Imager: {imager}")

if notes:
    print()
    print("What's new:")
    for item in notes:
        print(f"- {item}")
PY
}

print_fallback() {
  local url="$1"
  cat <<EOF
Update system
RASPIAUDIO CamillaDSP Box
Current version: $(current_version)

Update information is not online yet.

When a new image is published, update by flashing it with Raspberry Pi Imager,
then boot and open http://raspiaudio.local.

Download page:
  https://raspiaudio.com/camilladsp-box

Checked:
  $url
EOF

  if [ -f "$FALLBACK_CHANGELOG" ]; then
    echo
    echo "What's included in this image:"
    awk '/^- / { gsub("`", ""); print }' "$FALLBACK_CHANGELOG" | sed -n '1,8p'
  fi
}

URL="$(channel_url)"
if ! fetch_and_print_channel "$URL"; then
  print_fallback "$URL"
fi
