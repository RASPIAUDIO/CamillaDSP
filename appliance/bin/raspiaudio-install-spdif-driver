#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR="${RASPIAUDIO_SPDIF_SOURCE_DIR:-/opt/raspiaudio-spdif-gpio}"
KERNEL_DIR="${SOURCE_DIR}/kernel"
MODULE_NAME="raspiaudio_spdif_pio"
MODULE_PATH="/lib/modules/$(uname -r)/extra/${MODULE_NAME}.ko"
GPIO="${SPDIF_GPIO:-12}"
DRIVE_MA="${SPDIF_DRIVE_MA:-8}"
ZERO_ON_UNDERRUN="${SPDIF_ZERO_ON_UNDERRUN:-1}"
STAMP="/etc/raspiaudio/spdif-driver-installed"
APT_UPDATED=0

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -E bash "$0" "$@"
fi

if [ ! -f "$KERNEL_DIR/${MODULE_NAME}.c" ]; then
  echo "Missing S/PDIF kernel source: $KERNEL_DIR/${MODULE_NAME}.c" >&2
  exit 1
fi

KDIR="${KDIR:-/lib/modules/$(uname -r)/build}"
install_kernel_headers() {
  [ "${RASPIAUDIO_INSTALL_HEADERS:-1}" = "0" ] && return 1
  command -v apt-get >/dev/null 2>&1 || return 1

  export DEBIAN_FRONTEND=noninteractive
  if [ "$APT_UPDATED" = "0" ]; then
    apt-get update
    APT_UPDATED=1
  fi
  apt-get install -y --no-install-recommends build-essential

  local krel
  local pkg
  local installed=1
  local candidates=()
  krel="$(uname -r)"
  candidates+=("linux-headers-${krel}")
  case "$krel" in
    *rpi-2712*) candidates+=("linux-headers-rpi-2712") ;;
    *rpi-v8*) candidates+=("linux-headers-rpi-v8") ;;
  esac
  candidates+=("raspberrypi-kernel-headers")

  for pkg in "${candidates[@]}"; do
    if ! apt-cache show "$pkg" >/dev/null 2>&1; then
      echo "Kernel header package not found in apt: $pkg"
      continue
    fi
    echo "Installing kernel header package: $pkg"
    apt-get install -y --no-install-recommends "$pkg" && installed=0
    [ -d "$KDIR" ] && return 0
  done

  return "$installed"
}

if [ ! -d "$KDIR" ]; then
  echo "Missing kernel build directory: $KDIR"
  echo "Trying to install build-essential and matching Raspberry Pi kernel headers..."
  install_kernel_headers || true
fi

if [ ! -d "$KDIR" ]; then
  echo "Missing kernel build directory after header install attempt: $KDIR" >&2
  echo "Running kernel: $(uname -r)" >&2
  echo "Available module trees:" >&2
  ls -1 /lib/modules >&2 || true
  echo "Install matching Raspberry Pi kernel headers, then rerun raspiaudio-install-spdif-driver." >&2
  exit 1
fi

make -C "$KDIR" M="$KERNEL_DIR" modules
install -D -m 0644 "$KERNEL_DIR/${MODULE_NAME}.ko" "$MODULE_PATH"

cat >/etc/modprobe.d/raspiaudio-spdif.conf <<EOF
options ${MODULE_NAME} gpio=${GPIO} drive_ma=${DRIVE_MA} zero_on_underrun=${ZERO_ON_UNDERRUN}
EOF

# Loading through modules-load.d can run before RP1/PIO is ready on Pi 5.
# The appliance uses raspiaudio-spdif.service instead, ordered before CamillaDSP.
rm -f /etc/modules-load.d/raspiaudio-spdif.conf
rm -f /etc/modules-load.d/raspiaudio-spdif-pio.conf

depmod

if [ "${RASPIAUDIO_IMAGE_BUILD:-0}" != "1" ]; then
  modprobe rp1-pio || true
  modprobe -r "$MODULE_NAME" 2>/dev/null || true
  modprobe "$MODULE_NAME" gpio="$GPIO" drive_ma="$DRIVE_MA" zero_on_underrun="$ZERO_ON_UNDERRUN"
fi

install -d -m 0755 /etc/raspiaudio
date -Is >"$STAMP"

systemctl disable raspiaudio-spdif-firstboot.service >/dev/null 2>&1 || true
systemctl enable raspiaudio-spdif.service >/dev/null 2>&1 || true

echo "Installed ${MODULE_NAME} for kernel $(uname -r) on GPIO${GPIO}."
