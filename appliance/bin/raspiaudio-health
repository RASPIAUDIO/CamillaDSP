#!/usr/bin/env python3
import argparse
import json
import pathlib
import re
import subprocess
import sys


MODE_CMD = "/usr/local/sbin/raspiaudio-mode"
BOX_CONFIG = pathlib.Path("/etc/raspiaudio/box.conf")
USB_G_AUDIO_CONFIG = pathlib.Path("/etc/modprobe.d/usb_g_audio.conf")
CURRENT_CONFIG = pathlib.Path("/etc/camilladsp/current.yml")
UDC_DIR = pathlib.Path("/sys/class/udc")


def run(args, timeout=5):
    try:
        completed = subprocess.run(
            args,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
        return completed.returncode, completed.stdout
    except Exception as exc:
        return -1, str(exc)


def read_text(path):
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return ""


def service_state(name):
    code, out = run(["systemctl", "is-active", name], timeout=3)
    state = out.strip() if out.strip() else "unknown"
    return state if code == 0 else state


def command_output(*args):
    _, out = run(list(args), timeout=5)
    return out


def network_addresses():
    out = command_output("hostname", "-I")
    addresses = []
    for item in out.split():
        if item.startswith("127.") or item == "::1":
            continue
        addresses.append(item)
    return addresses


def usb_udc_states():
    states = []
    if not UDC_DIR.exists():
        return states
    for udc in sorted(UDC_DIR.iterdir()):
        state_path = udc / "state"
        try:
            state = state_path.read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            state = "unknown"
        states.append({"name": udc.name, "state": state or "unknown"})
    return states


def load_mode_status():
    code, out = run([MODE_CMD, "status-json"], timeout=5)
    if code != 0:
        return {
            "hardware": "unknown",
            "active_mode": "unknown",
            "active_mode_label": "Unknown",
            "sample_rate": "48000",
            "current_config": "",
            "mode_error": out.strip(),
        }
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {"mode_error": out.strip()}


def add_check(checks, key, label, ok, level, message, action=""):
    checks.append(
        {
            "key": key,
            "label": label,
            "ok": bool(ok),
            "level": "ok" if ok else level,
            "message": message,
            "action": action,
        }
    )


def detect_cards(text, pattern):
    return re.search(pattern, text, flags=re.IGNORECASE) is not None


def build_health():
    mode = load_mode_status()
    hardware = str(mode.get("hardware", "unknown"))
    hardware_config = str(mode.get("hardware_config", hardware))
    detected_hardware = str(mode.get("detected_hardware", "unknown"))
    checks = []

    hostname = command_output("hostname").strip()
    add_check(
        checks,
        "hostname",
        "raspiaudio.local",
        hostname == "raspiaudio",
        "warning",
        f"Hostname is {hostname or 'unknown'}." if hostname == "raspiaudio" else f"Hostname is {hostname or 'unknown'}, expected raspiaudio.",
        "Reboot after the appliance install or run hostnamectl set-hostname raspiaudio.",
    )

    avahi = service_state("avahi-daemon")
    add_check(
        checks,
        "mdns",
        "mDNS service",
        avahi == "active",
        "warning",
        f"avahi-daemon is {avahi}.",
        "Start avahi-daemon or open the dashboard with the Pi IP address.",
    )

    addresses = network_addresses()
    add_check(
        checks,
        "network_address",
        "Network fallback address",
        bool(addresses),
        "warning",
        f"Fallback address: http://{addresses[0]}/" if addresses else "No non-loopback IP address was found.",
        "If http://raspiaudio.local does not open, connect Ethernet/Wi-Fi and use the Pi IP address.",
    )

    camilla = service_state("camilladsp.service")
    add_check(
        checks,
        "camilladsp",
        "CamillaDSP",
        camilla == "active",
        "error",
        f"camilladsp.service is {camilla}.",
        "Use Restart audio, then download diagnostics if it stays inactive.",
    )

    gui = service_state("camillagui.service")
    add_check(
        checks,
        "camillagui",
        "Advanced editor",
        gui == "active",
        "warning",
        f"camillagui.service is {gui}.",
        "The simple dashboard can still work; restart audio services if Advanced editor is needed.",
    )

    web = service_state("raspiaudio-web.service")
    add_check(
        checks,
        "web",
        "Dashboard service",
        web == "active",
        "warning",
        f"raspiaudio-web.service is {web}.",
        "If this page is visible, the web backend may be running manually or through nginx.",
    )

    if hardware_config == "auto":
        auto_ok = hardware in ("8xout", "8xin8xout")
        add_check(
            checks,
            "hardware_autodetect",
            "RASPIAUDIO hardware auto-detect",
            auto_ok,
            "warning",
            (
                f"Auto-detected {hardware} from ALSA. "
                "The hifiberry-dac8x overlay uses GPIO5 active-low as hasadc-gpio."
            )
            if auto_ok
            else (
                "Auto-detect could not find the RASPIAUDIO ALSA card yet. "
                "The hifiberry-dac8x overlay uses GPIO5 active-low as hasadc-gpio."
            ),
            "Check HAT seating, dtoverlay=hifiberry-dac8x and reboot.",
        )
    elif detected_hardware in ("8xout", "8xin8xout") and detected_hardware != hardware:
        add_check(
            checks,
            "hardware_manual_override",
            "RASPIAUDIO hardware manual override",
            False,
            "warning",
            f"Hardware is forced to {hardware}, but ALSA detection sees {detected_hardware}.",
            "Use Auto detect unless you are doing a lab override.",
        )

    usb_config = read_text(USB_G_AUDIO_CONFIG)
    usb_profile_ok = (
        "c_srate=48000" in usb_config
        and "c_ssize=4" in usb_config
        and "c_chmask=0x63f" in usb_config
        and "p_chmask=0" in usb_config
    )
    add_check(
        checks,
        "usb_profile",
        "USB 7.1 profile",
        usb_profile_ok,
        "error",
        "USB gadget config is 8ch / 48 kHz / S32_LE." if usb_profile_ok else "USB gadget config is missing or not the V1 7.1 profile.",
        "Re-run the appliance installer, then reboot with the USB-C data cable connected.",
    )

    modules = command_output("lsmod")
    g_audio_loaded = "g_audio" in modules
    add_check(
        checks,
        "g_audio",
        "USB audio gadget module",
        g_audio_loaded,
        "warning",
        "g_audio is loaded." if g_audio_loaded else "g_audio is not loaded yet.",
        "Reboot after enabling the gadget profile; Windows may also need the USB cable replugged.",
    )

    udc_states = usb_udc_states()
    configured = any(item["state"] == "configured" for item in udc_states)
    states_text = ", ".join(f"{item['name']}={item['state']}" for item in udc_states)
    add_check(
        checks,
        "usb_link_state",
        "USB-C data link",
        configured,
        "warning",
        f"USB gadget controller is configured by the host ({states_text})."
        if configured
        else f"USB gadget controller is not configured by a host ({states_text or 'no UDC found'}).",
        "Plug the data side of the USB-C splitter into the computer, then replug or reboot if the RASPIAUDIO USB sound card is not listed.",
    )

    arecord = command_output("arecord", "-l")
    uac2_present = detect_cards(arecord, r"UAC2Gadget|UAC2_Gadget")
    add_check(
        checks,
        "uac2_capture",
        "Pi USB audio input",
        uac2_present,
        "error",
        "UAC2Gadget capture card is present." if uac2_present else "UAC2Gadget capture card is not visible to ALSA.",
        "Check the USB-C data cable, splitter orientation, dwc2 overlay and reboot.",
    )

    aplay = command_output("aplay", "-l")
    analog_out = detect_cards(aplay, r"sndrpihifiberry|hifiberry|dac8")
    add_check(
        checks,
        "analog_out",
        "8 analog outputs",
        analog_out,
        "error",
        "RASPIAUDIO analog output card is present." if analog_out else "RASPIAUDIO analog output card is not visible.",
        "Check the HAT, GPIO seating and dtoverlay=hifiberry-dac8x.",
    )

    if hardware == "8xin8xout":
        analog_in = detect_cards(arecord, r"sndrpihifiberry|hifiberry|dac8")
        add_check(
            checks,
            "analog_in",
            "8 analog inputs",
            analog_in,
            "error",
            "RASPIAUDIO analog input card is present." if analog_in else "8xIN ADC capture is not visible.",
            "Check the 8xIN+8xOUT board, GPIO5 hasadc detection and dtoverlay=hifiberry-dac8x.",
        )

    spdif = detect_cards(aplay, r"RASPISPDIF")
    add_check(
        checks,
        "toslink",
        "TOSLINK output",
        spdif,
        "warning",
        "RASPISPDIF ALSA card is present." if spdif else "RASPISPDIF ALSA card is not visible.",
        "The first-boot driver build may still need to run; check diagnostics if optical mode is needed.",
    )

    current_target = ""
    try:
        current_target = str(CURRENT_CONFIG.resolve(strict=True))
    except FileNotFoundError:
        current_target = str(CURRENT_CONFIG)
    config_ok = CURRENT_CONFIG.exists() or CURRENT_CONFIG.is_symlink()
    add_check(
        checks,
        "current_config",
        "Active profile",
        config_ok,
        "error",
        f"Current profile is {current_target}." if config_ok else "No active CamillaDSP profile link exists.",
        "Use Factory reset audio or choose a mode from the dashboard.",
    )

    status = "ok"
    if any(check["level"] == "error" for check in checks):
        status = "error"
    elif any(check["level"] == "warning" for check in checks):
        status = "warning"

    return {
        "status": status,
        "mode": mode,
        "checks": checks,
        "summary": {
            "errors": sum(1 for check in checks if check["level"] == "error"),
            "warnings": sum(1 for check in checks if check["level"] == "warning"),
            "ok": sum(1 for check in checks if check["level"] == "ok"),
        },
    }


def print_text(report):
    print(f"RASPIAUDIO health: {report['status']}")
    for check in report["checks"]:
        marker = "OK" if check["level"] == "ok" else check["level"].upper()
        print(f"[{marker}] {check['label']}: {check['message']}")
        if check["level"] != "ok" and check.get("action"):
            print(f"  action: {check['action']}")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON")
    args = parser.parse_args()
    report = build_health()
    if args.json:
        json.dump(report, sys.stdout, indent=2)
        print()
    else:
        print_text(report)


if __name__ == "__main__":
    main()
